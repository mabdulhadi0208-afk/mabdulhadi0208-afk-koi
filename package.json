{
  "name": "koi",
  "version": "1.0.0",
  "description": "Koi — a springy, fluid fan app switcher for macOS",
  "main": "main.js",
  "author": "Koi",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.koi.switcher",
    "productName": "Koi",
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "renderer/**",
      "assets/**"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Koi-mac-${arch}.${ext}",
      "extendInfo": {
        "LSUIElement": true
      },
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Koi",
      "window": {
        "width": 540,
        "height": 420
      },
      "contents": [
        {
          "x": 140,
          "y": 170,
          "type": "file"
        },
        {
          "x": 400,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 270,
          "y": 310,
          "type": "file",
          "path": "build/Fix-Koi-if-damaged.command"
        }
      ]
    },
    "afterPack": "build/afterPack.js",
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ]
  },
  "dependencies": {
    "uiohook-napi": "^1.5.4"
  }
}